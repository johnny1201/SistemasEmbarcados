// Definições para LCD (ajuste pinos conforme seu hardware)
sbit LCD_RS at RE2_bit;
sbit LCD_EN at RE1_bit;
sbit LCD_D7 at RD7_bit;
sbit LCD_D6 at RD6_bit;
sbit LCD_D5 at RD5_bit;
sbit LCD_D4 at RD4_bit;

sbit LCD_RS_Direction at TRISE2_bit;
sbit LCD_EN_Direction at TRISE1_bit;
sbit LCD_D7_Direction at TRISD7_bit;
sbit LCD_D6_Direction at TRISD6_bit;
sbit LCD_D5_Direction at TRISD5_bit;
sbit LCD_D4_Direction at TRISD4_bit;

// Variáveis globais
char recebido;
unsigned int tentativas = 0;
int resetFlag = 0;

void main() {
    // Configuração inicial
    ADCON1 = 0x0F;       // Todas as portas como digitais
    TRISB.F1 = 1;        // RB1 como entrada (botão reset)
    INTCON2.RBPU = 0;    // Ativa pull-ups internos em PORTB

    // Inicializa LCD
    Lcd_Init();
    Lcd_Cmd(_LCD_CURSOR_OFF);
    Lcd_Cmd(_LCD_CLEAR);

    // Inicializa UART
    UART1_Init(9600);
    Delay_ms(100);

    // Mensagem inicial
    Lcd_Out(1, 1, "Cofre Inicializado");
    Lcd_Out(2, 1, "Tentativas: 0");

    while(1) {
        // Verifica se recebeu algo pela UART
        if (UART1_Data_Ready()) {
            recebido = UART1_Read();

            switch (recebido) {
                case 'E': // Tentativa errada
                    tentativas++;

                    Lcd_Cmd(_LCD_CLEAR);
                    Lcd_Out(1, 1, "Senha Errada!");
                    Lcd_Out(2, 1, "Tentativas:");

                    if (tentativas == 1) {
                        Lcd_Out(2, 13, "1");
                    } else if (tentativas == 2) {
                        Lcd_Out(2, 13, "2");
                    } else if (tentativas == 3) {
                        Lcd_Out(2, 13, "3");
                    } else if (tentativas >= 4) {
                        Lcd_Cmd(_LCD_CLEAR);
                        Lcd_Out(1, 1, "  Cofre  ");
                        Lcd_Out(2, 1, "Bloqueado!");
                    }
                    break;

                case 'U': // Senha correta
                    Lcd_Cmd(_LCD_CLEAR);
                    Lcd_Out(1, 1, "ACESSO LIBERADO!");
                    Lcd_Out(2, 1, "Cofre aberto");
                    tentativas = 0;
                    break;

                default:
                    break;
            }
        }

        // Verifica botão reset (ativo baixo: pressionado = 0)
        if (PORTB.F1 == 0 && resetFlag == 0) {
            resetFlag = 1;
            tentativas = 0;
            Lcd_Cmd(_LCD_CLEAR);
            Lcd_Out(1, 1, "Tentativas zeradas");
            Lcd_Out(2, 1, "Sistema resetado");
            UART1_Write('R');  // Envia comando de reset para o Arduino
            Delay_ms(500);     // Anti-repique simples
        }

        // Libera flag quando botão for solto
        if (PORTB.F1 == 1) {
            resetFlag = 0;
        }
    }
}
